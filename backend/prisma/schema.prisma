generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FitnessGoal {
  WEIGHT_GAIN
  WEIGHT_LOSS
  MAINTAIN_WEIGHT
  BUILD_STRENGTH
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  OTHER
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  passwordHash      String
  age               Int
  heightCm          Float
  currentWeightKg   Float
  targetWeightKg    Float?
  fitnessGoal       FitnessGoal
  activityLevel     ActivityLevel      @default(MODERATELY_ACTIVE)
  dietaryPreference DietaryPreference  @default(NONE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([createdAt])
}
