generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FitnessGoal {
  WEIGHT_GAIN
  WEIGHT_LOSS
  MAINTAIN_WEIGHT
  BUILD_STRENGTH
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum DietaryPreference {
  NONE
  VEGETARIAN
  VEGAN
  PESCATARIAN
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  passwordHash      String
  age               Int
  heightCm          Float
  currentWeightKg   Float
  startingWeightKg  Float              @default(75)
  targetWeightKg    Float?
  fitnessGoal       FitnessGoal
  activityLevel     ActivityLevel      @default(MODERATELY_ACTIVE)
  dietaryPreference DietaryPreference  @default(NONE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  customExercises   Exercise[]         @relation("CustomExercises")
  workoutTemplates  WorkoutTemplate[]
  workoutPlans      WorkoutPlan[]
  workoutSessions   WorkoutSession[]
  personalRecords   PersonalRecord[]
  weightEntries     WeightEntry[]
  foods             Food[]             @relation("CustomFoods")
  foodLogs          FoodLog[]
  nutritionTarget   NutritionTarget?
  dietPlans         DietPlan[]

  @@index([createdAt])
}

model Exercise {
  id            String   @id @default(cuid())
  name          String
  muscleGroup   String
  equipment     String
  description   String
  difficulty    String
  exerciseType  String?
  instructions  String[]
  imageUrl      String?
  ownerId       String?
  owner         User?    @relation("CustomExercises", fields: [ownerId], references: [id], onDelete: Cascade)
  templateUses  WorkoutTemplateExercise[]
  planUses      WorkoutPlanExercise[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([muscleGroup, equipment])
  @@index([ownerId])
}

model WorkoutTemplate {
  id        String                    @id @default(cuid())
  name      String
  notes     String?
  ownerId   String
  owner     User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@index([ownerId, updatedAt])
}

model WorkoutTemplateExercise {
  id              String          @id @default(cuid())
  templateId      String
  template        WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order           Int
  sets            Int
  targetReps      Int
  targetWeightKg  Float?
  restSeconds     Int             @default(60)
  notes           String?

  @@unique([templateId, order])
  @@index([exerciseId])
}

model WorkoutPlan {
  id              String           @id @default(cuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  planType        String
  goal            String
  level           String
  splitPreference String
  daysPerWeek     Int
  availableMinutes Int
  equipment       String[]
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  isActive        Boolean          @default(true)
  days            WorkoutPlanDay[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([ownerId, isActive, startDate, endDate])
}

model WorkoutPlanDay {
  id                       String                @id @default(cuid())
  planId                   String
  plan                     WorkoutPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  date                     DateTime              @db.Date
  dayOfWeek                Int
  title                    String
  focus                    String
  isRestDay                Boolean               @default(false)
  status                   String                @default("PLANNED")
  estimatedDurationMinutes Int
  warmup                   String
  cooldown                 String
  phase                    String
  guidance                 String
  exercises                WorkoutPlanExercise[]
  sessions                 WorkoutSession[]

  @@unique([planId, date])
  @@index([date, status])
}

model WorkoutPlanExercise {
  id          String         @id @default(cuid())
  dayId       String
  day         WorkoutPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order       Int
  sets        Int
  reps        Int
  restSeconds Int
  notes       String?

  @@unique([dayId, order])
  @@unique([dayId, exerciseId])
}

model WorkoutSession {
  id              String                  @id @default(cuid())
  name            String
  ownerId         String
  owner           User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  templateId      String?
  template        WorkoutTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  planDayId       String?
  planDay         WorkoutPlanDay?         @relation(fields: [planDayId], references: [id], onDelete: SetNull)
  startedAt       DateTime                @default(now())
  finishedAt      DateTime?
  durationSeconds Int?
  exercises       WorkoutExercise[]
  personalRecords PersonalRecord[]

  @@index([ownerId, startedAt])
}

model WorkoutExercise {
  id              String         @id @default(cuid())
  sessionId       String
  session         WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name            String
  muscleGroup     String
  equipment       String
  description     String
  difficulty      String
  exerciseType    String?
  instructions    String[]
  imageUrl        String?
  order           Int
  targetSets      Int
  targetReps      Int
  targetWeightKg  Float?
  restSeconds     Int
  notes           String?
  sets            WorkoutSet[]

  @@unique([sessionId, order])
}

model WorkoutSet {
  id                String          @id @default(cuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  reps              Int
  weightKg          Float
  completed         Boolean         @default(true)
  completedAt       DateTime        @default(now())

  @@unique([workoutExerciseId, setNumber])
}

model PersonalRecord {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workoutSessionId   String
  workoutSession     WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exerciseName       String
  recordType         String
  value              Float
  previousValue      Float?
  weightKg           Float?
  reps               Int?
  achievedAt         DateTime @default(now())

  @@index([ownerId, achievedAt])
  @@index([ownerId, exerciseName, recordType])
}

model WeightEntry {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  weightKg  Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, date])
  @@index([ownerId, date])
}

model Food {
  id                 String     @id @default(cuid())
  name               String
  category           String
  servingUnit        String
  servingSize        Float
  calories           Float
  proteinGrams       Float
  carbohydratesGrams Float
  fatGrams           Float
  dietaryTags        String[]   @default([])
  ownerId            String?
  owner              User?      @relation("CustomFoods", fields: [ownerId], references: [id], onDelete: Cascade)
  logs               FoodLog[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([ownerId, name])
  @@index([category])
}

model FoodLog {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  foodId             String?
  food               Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  foodName           String
  servingUnit        String
  servingSize        Float
  quantity           Float
  mealType           MealType
  calories           Float
  proteinGrams       Float
  carbohydratesGrams Float
  fatGrams           Float
  loggedAt           DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId, loggedAt])
  @@index([ownerId, mealType, loggedAt])
}

model NutritionTarget {
  id                    String   @id @default(cuid())
  ownerId               String   @unique
  owner                 User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  maintenanceCalories   Int
  dailyCalories         Int
  proteinGrams          Float
  carbohydratesGrams    Float
  fatGrams              Float
  isCustom              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

}

model DietPlan {
  id                    String         @id @default(cuid())
  ownerId               String
  owner                 User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  date                  DateTime       @db.Date
  goal                  String
  dietaryPreference     DietaryPreference
  estimatedCalories     Float
  estimatedProteinGrams Float
  estimatedCarbsGrams   Float
  estimatedFatGrams     Float
  meals                 DietPlanMeal[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([ownerId, date])
}

model DietPlanMeal {
  id           String   @id @default(cuid())
  planId       String
  plan         DietPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  mealType     MealType
  name         String
  ingredients  Json
  nutrition    Json

  @@unique([planId, mealType])
  @@index([planId])
}
